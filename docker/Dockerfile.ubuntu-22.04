FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive
ARG RUST_TOOLCHAIN=1.96.1

ENV CARGO_HOME=/opt/rust/cargo \
    RUSTUP_HOME=/opt/rust/rustup \
    TMPDIR=/workspace/tmp \
    PATH=/opt/rust/cargo/bin:${PATH}

RUN mkdir -p "$TMPDIR" "$CARGO_HOME" "$RUSTUP_HOME"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        binutils \
        build-essential \
        ca-certificates \
        cmake \
        cpio \
        curl \
        file \
        fontconfig \
        git \
        gnutls-bin \
        libbz2-dev \
        libcurl4-openssl-dev \
        libdbus-1-dev \
        libfontconfig1-dev \
        libfreetype-dev \
        libglib2.0-dev \
        libgnutls28-dev \
        libgstreamer-plugins-base1.0-dev \
        libgstreamer1.0-dev \
        liblzma-dev \
        libsqlite3-dev \
        libssl-dev \
        libsystemd-dev \
        libvulkan-dev \
        libwayland-dev \
        libxcb1-dev \
        libxcursor-dev \
        libxi-dev \
        libxinerama-dev \
        libxkbcommon-dev \
        libxkbcommon-x11-dev \
        libxml2-dev \
        libxrandr-dev \
        m4 \
        mesa-vulkan-drivers \
        pkg-config \
        rpm \
        wayland-protocols \
        zlib1g-dev \
    && apt-get clean \
    && find /var/lib/apt/lists -mindepth 1 -delete

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain "$RUST_TOOLCHAIN" \
    && rustc --version \
    && cargo --version

WORKDIR /workspace

CMD ["bash"]
